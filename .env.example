# =========================================================
# VARIABLES D'ENVIRONNEMENT — Dognon Franck Portfolio
# Copiez ce fichier en .env et remplissez les valeurs
# =========================================================

# --- Base de données ---
# Preview (SQLite) :
DATABASE_URL=file:./db/custom.db
#
# Production (Neon PostgreSQL) :
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Better Auth ---
# Générez avec : openssl rand -base64 32
BETTER_AUTH_SECRET=changez-ce-secret-par-un-secret-long-et-securise
BETTER_AUTH_URL=http://localhost:3000

# --- OAuth GitHub (optionnel) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OAuth Google (optionnel) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary (upload de médias) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (envoi d'emails) ---
RESEND_API_KEY=

# --- Email de contact ---
CONTACT_EMAIL=yvandr186@gmail.com
